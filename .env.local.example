# Copy this file to .env.local and fill in the password.
#
#   cp .env.local.example .env.local && open -e .env.local
#
# .env.local is gitignored. This example file is not, and must never contain a
# real password.
#
# Used by:  npm run baseline:capture   (scripts/capture-baseline.mjs)
#           npm run smoke:order        (scripts/smoke-place-order.mjs)
#
# Get the string from Supabase → Connect → Session pooler, and replace
# [YOUR-PASSWORD] with the database password. One line, no quotes.
SUPABASE_DB_URL=postgresql://postgres.pqpnwxyevrsipklzmwex:[YOUR-PASSWORD]@aws-1-eu-west-2.pooler.supabase.com:5432/postgres
