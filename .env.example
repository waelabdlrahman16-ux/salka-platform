VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional locally. In production both are set as GitHub repo secrets and
# read by .github/workflows/deploy.yml -- without them, Sentry error
# monitoring stays inert and the push-notification opt-in button hides
# itself instead of failing loudly.
VITE_SENTRY_DSN=
VITE_FIREBASE_VAPID_KEY=
