  "type": "module",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-firebase-sw-version.mjs && tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
